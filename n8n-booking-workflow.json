{
  "name": "Know Thyself — Retreat Booking (Razorpay)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "knowthyself-booking",
        "responseMode": "responseNode",
        "options": { "rawBody": true }
      },
      "id": "webhook",
      "name": "Booking Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-720, 300],
      "webhookId": "knowthyself-booking"
    },
    {
      "parameters": {
        "jsCode": "// The site posts text/plain so the body may arrive as a raw string.\nconst EXPECTED_AMOUNT_PAISE = {\n  'Know Thyself · Mussoorie': 17582000\n};\n\nconst raw = $input.first().json;\nlet d = raw.body ?? raw;\nif (typeof d === 'string') { try { d = JSON.parse(d); } catch (e) { d = {}; } }\nif (d && typeof d.data === 'string') { try { d = JSON.parse(d.data); } catch (e) {} }\n\nreturn [{\n  json: {\n    status: d.status || '',\n    name: d.name || '',\n    email: d.email || '',\n    phone: d.phone || '',\n    event_name: d.event_name || '',\n    event_dates: d.event_dates || '',\n    amount: d.amount || '',\n    amount_display: d.amount_display || '',\n    payment_id: d.payment_id || '',\n    reason: d.reason || '',\n    expected_amount_paise: EXPECTED_AMOUNT_PAISE[d.event_name] || null\n  }\n}];"
      },
      "id": "parse",
      "name": "Parse Booking",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-500, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "combinator": "and",
          "conditions": [
            {
              "id": "is-booked",
              "operator": { "type": "string", "operation": "equals" },
              "leftValue": "={{ $json.status }}",
              "rightValue": "booked"
            }
          ]
        },
        "options": {}
      },
      "id": "is-booked",
      "name": "Paid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-280, 300]
    },
    {
      "parameters": {
        "url": "=https://api.razorpay.com/v1/payments/{{ $json.payment_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "fetch-payment",
      "name": "Razorpay — Fetch Payment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-60, 180],
      "credentials": {
        "httpBasicAuth": { "id": "razorpay-live", "name": "Razorpay Live API Keys" }
      },
      "notes": "Basic auth: user = Razorpay Key ID, password = Key Secret. Stored in n8n credentials, never in this file."
    },
    {
      "parameters": {
        "jsCode": "const booking = $('Parse Booking').first().json;\nconst pay = $input.first().json || {};\n\nconst captured = pay.status === 'captured' || pay.status === 'authorized';\nconst expected = booking.expected_amount_paise;\nconst amountOk = !expected || pay.amount === expected;\nconst verified = Boolean(captured && amountOk);\n\nconst display = typeof pay.amount === 'number'\n  ? '₹' + Number(pay.amount / 100).toLocaleString('en-IN')\n  : booking.amount_display;\n\nreturn [{\n  json: {\n    ...booking,\n    status: verified ? 'booked' : 'unverified',\n    amount_display: display,\n    verified,\n    reason: verified ? '' : ('status=' + (pay.status || 'unknown') + ', amount=' + (pay.amount ?? 'unknown'))\n  }\n}];"
      },
      "id": "verify",
      "name": "Verify Payment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [160, 180]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "combinator": "and",
          "conditions": [
            {
              "id": "verified",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true },
              "leftValue": "={{ $json.verified }}"
            }
          ]
        },
        "options": {}
      },
      "id": "is-verified",
      "name": "Verified?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [380, 180]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "=Your Seat Is Confirmed — {{ $json.event_name }}",
        "message": "=<div style=\"font-family:Arial,sans-serif;max-width:560px;margin:auto;color:#23301f\"><h2 style=\"color:#3a7a2c\">Your seat is booked 🎉</h2><p>Dear {{ $json.name }},</p><p>Thank you for reserving your place at <b>{{ $json.event_name }}</b>. We can't wait to welcome you.</p><table style=\"border-collapse:collapse;margin:16px 0\"><tr><td style=\"padding:6px 14px 6px 0;color:#718169\">Retreat</td><td style=\"padding:6px 0;font-weight:bold\">{{ $json.event_name }}</td></tr><tr><td style=\"padding:6px 14px 6px 0;color:#718169\">Dates</td><td style=\"padding:6px 0;font-weight:bold\">{{ $json.event_dates }}</td></tr><tr><td style=\"padding:6px 14px 6px 0;color:#718169\">Amount Paid</td><td style=\"padding:6px 0;font-weight:bold\">{{ $json.amount_display }}</td></tr><tr><td style=\"padding:6px 14px 6px 0;color:#718169\">Payment ID</td><td style=\"padding:6px 0;font-weight:bold\">{{ $json.payment_id }}</td></tr></table><p>A team member will reach out shortly with travel and preparation details.</p><p style=\"color:#718169;font-size:13px\">With warmth,<br>Know Thyself Retreat</p></div>",
        "options": { "senderName": "Know Thyself Retreat" }
      },
      "id": "mail-guest-confirmed",
      "name": "Email Guest — Confirmed",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [620, 60],
      "credentials": {
        "gmailOAuth2": { "id": "gmail-knowthyself", "name": "Gmail — Know Thyself" }
      }
    },
    {
      "parameters": {
        "sendTo": "ar.happinessmovement@gmail.com",
        "subject": "=New booking — {{ $json.event_name }} — {{ $json.name }}",
        "message": "=New confirmed booking:<br><br>Name: {{ $json.name }}<br>Email: {{ $json.email }}<br>Phone: {{ $json.phone }}<br>Event: {{ $json.event_name }} ({{ $json.event_dates }})<br>Amount: {{ $json.amount_display }}<br>Payment ID: {{ $json.payment_id }}",
        "options": { "senderName": "Know Thyself Retreat" }
      },
      "id": "mail-admin-booking",
      "name": "Email Admin — New Booking",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [620, 220],
      "credentials": {
        "gmailOAuth2": { "id": "gmail-knowthyself", "name": "Gmail — Know Thyself" }
      }
    },
    {
      "parameters": {
        "sendTo": "ar.happinessmovement@gmail.com",
        "subject": "=⚠️ Unverified payment attempt — {{ $json.event_name }}",
        "message": "=A booking could not be verified with Razorpay and was NOT confirmed:<br><br>Name: {{ $json.name }}<br>Email: {{ $json.email }}<br>Phone: {{ $json.phone }}<br>Event: {{ $json.event_name }}<br>Payment ID: {{ $json.payment_id }}<br>Details: {{ $json.reason }}",
        "options": { "senderName": "Know Thyself Retreat" }
      },
      "id": "mail-admin-unverified",
      "name": "Email Admin — Unverified",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [620, 380],
      "credentials": {
        "gmailOAuth2": { "id": "gmail-knowthyself", "name": "Gmail — Know Thyself" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "combinator": "and",
          "conditions": [
            {
              "id": "failed",
              "operator": { "type": "string", "operation": "equals" },
              "leftValue": "={{ $json.status }}",
              "rightValue": "failed"
            }
          ]
        },
        "options": {}
      },
      "id": "is-failed",
      "name": "Failed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-60, 460]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "=Payment Could Not Be Completed — {{ $json.event_name }}",
        "message": "=<div style=\"font-family:Arial,sans-serif;max-width:560px;margin:auto;color:#23301f\"><h2 style=\"color:#a4614e\">Your payment didn't go through</h2><p>Dear {{ $json.name }},</p><p>We couldn't complete your payment for <b>{{ $json.event_name }}</b>{{ $json.reason ? ' (' + $json.reason + ')' : '' }}. No amount has been charged.</p><p>Your seat is not yet reserved. Please try again, or reply to this email and we'll help you complete your booking.</p><p style=\"color:#718169;font-size:13px\">Warm regards,<br>Know Thyself Retreat</p></div>",
        "options": { "senderName": "Know Thyself Retreat" }
      },
      "id": "mail-guest-failed",
      "name": "Email Guest — Payment Failed",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [160, 460],
      "credentials": {
        "gmailOAuth2": { "id": "gmail-knowthyself", "name": "Gmail — Know Thyself" }
      }
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "1JE_S0qRktHKFXzwrBwtD0Tzvz6BtfaasQxf1YLORE2I",
          "mode": "id"
        },
        "sheetName": { "__rl": true, "value": "Bookings", "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Timestamp": "={{ $now.toISO() }}",
            "Status": "={{ $json.status }}",
            "Name": "={{ $json.name }}",
            "Email": "={{ $json.email }}",
            "Phone": "={{ $json.phone }}",
            "Event": "={{ $json.event_name }}",
            "Dates": "={{ $json.event_dates }}",
            "Amount": "={{ $json.amount_display }}",
            "Payment ID": "={{ $json.payment_id }}",
            "Reason": "={{ $json.reason }}"
          },
          "matchingColumns": []
        },
        "options": {}
      },
      "id": "log-sheet",
      "name": "Log to Google Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [880, 300],
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "sheets-knowthyself", "name": "Google Sheets — Know Thyself" }
      },
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true }) }}",
        "options": {}
      },
      "id": "respond",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1100, 300]
    }
  ],
  "connections": {
    "Booking Webhook": { "main": [[{ "node": "Parse Booking", "type": "main", "index": 0 }]] },
    "Parse Booking": { "main": [[{ "node": "Paid?", "type": "main", "index": 0 }]] },
    "Paid?": {
      "main": [
        [{ "node": "Razorpay — Fetch Payment", "type": "main", "index": 0 }],
        [{ "node": "Failed?", "type": "main", "index": 0 }]
      ]
    },
    "Razorpay — Fetch Payment": { "main": [[{ "node": "Verify Payment", "type": "main", "index": 0 }]] },
    "Verify Payment": { "main": [[{ "node": "Verified?", "type": "main", "index": 0 }]] },
    "Verified?": {
      "main": [
        [
          { "node": "Email Guest — Confirmed", "type": "main", "index": 0 },
          { "node": "Email Admin — New Booking", "type": "main", "index": 0 }
        ],
        [{ "node": "Email Admin — Unverified", "type": "main", "index": 0 }]
      ]
    },
    "Email Guest — Confirmed": { "main": [[{ "node": "Log to Google Sheet", "type": "main", "index": 0 }]] },
    "Email Admin — Unverified": { "main": [[{ "node": "Log to Google Sheet", "type": "main", "index": 0 }]] },
    "Failed?": { "main": [[{ "node": "Email Guest — Payment Failed", "type": "main", "index": 0 }], []] },
    "Email Guest — Payment Failed": { "main": [[{ "node": "Log to Google Sheet", "type": "main", "index": 0 }]] },
    "Log to Google Sheet": { "main": [[{ "node": "Respond OK", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {},
  "meta": { "instanceId": "knowthyself" }
}
