    {
      "parameters": {
        "jsCode": "// ---- CONFIG ----\n// Expected total per event, in paise. Guards against price tampering.\nconst EXPECTED_AMOUNT_PAISE = {\n  'Know Thyself · Mussoorie': 17582000\n};\n// -----------------------------------------------\n\n// The site posts text/plain so the body may arrive as a raw string.\nconst raw = $input.first().json;\nlet d = raw.body ?? raw;\nif (typeof d === 'string') { try { d = JSON.parse(d); } catch (e) { d = {}; } }\nif (d && typeof d.data === 'string') { try { d = JSON.parse(d.data); } catch (e) {} }\n\n// WATI wants digits only with the country code: 919876543210\nfunction toWa(phone) {\n  let p = String(phone || '').replace(/\\D/g, '');\n  if (p.length === 10) p = '91' + p;                        // bare Indian mobile\n  if (p.length === 11 && p.charAt(0) === '0') p = '91' + p.slice(1);\n  return p;\n}\n\nreturn [{\n  json: {\n    name: d.name || '',\n    email: d.email || '',\n    phone: d.phone || '',\n    waNumber: toWa(d.phone),\n    event_name: d.event_name || '',\n    event_dates: d.event_dates || '',\n    amount_display: d.amount_display || '',\n    payment_id: d.payment_id || '',\n    reason: d.reason || '',\n    expected_amount_paise: EXPECTED_AMOUNT_PAISE[d.event_name] || null\n  }\n}];"
      },
      "id": "parse",
      "name": "Parse Booking",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -540,
        300
      ]
    },
    {
      "parameters": {
        "url": "=https://api.razorpay.com/v1/payments/{{ $json.payment_id || 'none' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "fetch-payment",
      "name": "Razorpay — Fetch Payment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -320,
        300
      ],
      "credentials": {
        "httpBasicAuth": {
          "id": "razorpay-live",
          "name": "Razorpay Live API Keys"
        }
      },
      "notes": "Basic Auth credential: User = Razorpay Key ID, Password = Key Secret. neverError so a failed/missing payment falls through to the failure branch instead of stopping the run."
    },
    {
      "parameters": {
        "jsCode": "const booking = $('Parse Booking').first().json;\nconst pay = $input.first().json || {};\n\n// Razorpay is the source of truth — not what the browser claimed.\nconst captured = pay.status === 'captured' || pay.status === 'authorized';\nconst expected = booking.expected_amount_paise;\nconst amountOk = !expected || pay.amount === expected;\n\nconst display = typeof pay.amount === 'number'\n  ? '₹' + Number(pay.amount / 100).toLocaleString('en-IN')\n  : booking.amount_display;\n\nlet reason = booking.reason;\nif (!captured) reason = 'payment not captured (status=' + (pay.status || 'not found') + ')';\nelse if (!amountOk) reason = 'amount mismatch: paid ' + pay.amount + ', expected ' + expected;\n\nreturn [{\n  json: {\n    ...booking,\n    is_captured: Boolean(captured && amountOk),\n    status: (captured && amountOk) ? 'booked' : 'failed',\n    amount_display: display,\n    reason: reason || ''\n  }\n}];"
      },
      "id": "check",
      "name": "Check Payment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -100,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "captured",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": "={{ $json.is_captured }}"
            }
          ]
        },
        "options": {}
      },
      "id": "if-captured",
      "name": "Captured?",
